STREAM_HOST=127.0.0.1
STREAM_PORT=8765
PUBLIC_BASE_URL=http://127.0.0.1:8765

# Optional fast API resolver. The easiest setup is to paste the complete
# Authorization header into this one value. Leave blank to use browser fallback.
SEPEHR_OAUTH_AUTHORIZATION=

# Advanced alternative: provide the three header components separately.
SEPEHR_OAUTH_CONSUMER_KEY=
SEPEHR_OAUTH_SIGNATURE=
SEPEHR_OAUTH_TOKEN=

USE_BROWSER_FALLBACK=1
CHROMIUM_PATH=
FORCE_HEIGHT=480
MAX_HEIGHT=480
LIVE_START_OFFSET_SECONDS=36
TOKEN_TTL_SECONDS=900
UPSTREAM_TIMEOUT_SECONDS=20

PREWARM_ON_START=1
PREWARM_SEGMENTS=0
WARM_INTERVAL_SECONDS=300
VIEWER_IDLE_SECONDS=75
SEGMENT_CACHE=1
SEGMENT_SINGLE_FLIGHT=1
CACHE_SEGMENTS=8
CACHE_MAX_BYTES=134217728
BUFFER_POLL_SECONDS=1
BUFFER_FETCH_CONCURRENCY=8

UPSTREAM_HOST_ALLOWLIST=sepehrtv.ir,sepehrapi.sepehrtv.ir
STATS_TOKEN=replace-with-a-long-random-token
